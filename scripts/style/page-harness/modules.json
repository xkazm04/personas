{
  "$comment": "Per-module data shared by the harness (registry.tsx), the recorder (record-tape.mjs) and the shooter. `record` is the /bridge-exec step list that brings the RUNNING app to the page while the tape rolls; `boot` lists commands the page needs from app boot (store preloads) that the recorder invokes itself so they land on the tape; `fill` answers commands a recording session does not reach on its own (they are appended as wildcards only when absent, and named in the tape's note).",
  "overview/sub_events": {
    "title": "Overview / Events",
    "record": [
      {
        "method": "navigate",
        "params": {
          "section": "home"
        }
      },
      {
        "method": "navigate",
        "params": {
          "section": "overview"
        }
      },
      {
        "method": "clickTestId",
        "params": {
          "testId": "tab-events"
        }
      }
    ],
    "boot": [
      [
        "list_personas",
        null
      ],
      [
        "get_persona_summaries",
        null
      ]
    ],
    "fill": {
      "search_events": {
        "events": [],
        "has_more": false
      }
    }
  },
  "home/sub_releases": {
    "title": "Home / What's New",
    "record": [
      {
        "method": "navigate",
        "params": {
          "section": "overview"
        }
      },
      {
        "method": "navigate",
        "params": {
          "section": "home"
        }
      },
      {
        "method": "clickTestId",
        "params": {
          "testId": "tab-roadmap"
        }
      }
    ],
    "boot": [],
    "fill": {}
  },
  "plugins/dev-tools/sub_triage": {
    "title": "Overview / Manual Review / Backlog (record with --manual: open Manual Review, then the Backlog mode tab; no test ids reach them)",
    "record": [
      {
        "method": "navigate",
        "params": {
          "section": "home"
        }
      },
      {
        "method": "navigate",
        "params": {
          "section": "overview"
        }
      }
    ],
    "boot": [
      [
        "dev_tools_list_projects",
        null
      ],
      [
        "dev_tools_list_ideas",
        null
      ]
    ],
    "fill": {}
  },
  "plugins/dev-tools/sub_triage/leaves": {
    "title": "sub_triage leaf states (synthetic only: mounted on props, not reachable by route)",
    "record": [
      {
        "method": "navigate",
        "params": {
          "section": "home"
        }
      },
      {
        "method": "navigate",
        "params": {
          "section": "overview"
        }
      }
    ],
    "boot": [
      [
        "dev_tools_list_projects",
        null
      ],
      [
        "dev_tools_list_ideas",
        null
      ]
    ],
    "fill": {}
  }
}
