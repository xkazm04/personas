# dir itself IS committed (it marks the repo as Personas-managed).
.personas/memory-outbox.jsonl
.personas/memory-outbox.full-*.jsonl
# Spillover written when the outbox exceeds its cap — same class, same rule.
.personas/memory-outbox.*-overflow.jsonl
.personas/backlog-digest.json

